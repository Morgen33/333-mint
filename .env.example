# Helius RPC (recommended for mint) — get a key at https://helius.dev
# Copy to .env and set your key so the mint page uses it.
VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Server-side upstream for api/rpc.js (set in Vercel env, never with a VITE_ prefix).
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Phantom Portal App ID — use this app in https://phantom.app/portal and verify your domain
# so Phantom does not show "new domain" / scam warnings. Add 333landingpage.vercel.app to allowed origins.
VITE_PHANTOM_APP_ID=85950ca1-bdc2-421a-a43a-d4aa9c90afb9

# When hosting on Manus / 333collection.xyz: use our API so "Load from wallet" doesn't hit CORS.
# VITE_RPC_URL=https://333collection.vercel.app/api/rpc
# VITE_METADATA_API=https://333collection.vercel.app

# Address Lookup Table for 333 mint (reduces tx size so Phantom/Lighthouse don't show scam warning).
# Create once: run scripts/create-lut.js then set this to the printed LUT address.
# VITE_333_LUT_ADDRESS=
